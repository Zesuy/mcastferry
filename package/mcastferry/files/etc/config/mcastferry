config mcastferry 'main'
	option enabled '0'
	option multicast_input 'IPTV'
	option http_listen '192.168.4.1:4022'
	list allowed_group '239.0.0.0/8'
	list allowed_client '192.168.4.0/24'
	list allowed_port '1-65535'
	option max_sessions '5'
	option max_clients '5'
	option max_clients_per_session '5'
	option max_clients_per_ip '5'
	option max_queue_bytes '524288'
	option client_write_timeout '2s'
	option session_idle_grace '1s'
	option playlist_path ''
	option playlist_route '/playlist.m3u'
	option playlist_max_bytes '2097152'
	option log_level 'info'
	option log_format 'text'
