#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/mcastferry

append_list_flag() {
	local value="$1"
	local flag="$2"
	[ -n "$value" ] && procd_append_param command "$flag" "$value"
}

start_instance() {
	local section="$1"
	local enabled multicast_input input_device http_listen
	local max_sessions max_clients max_clients_per_session max_clients_per_ip
	local max_queue_bytes client_write_timeout session_idle_grace
	local playlist_path playlist_route playlist_max_bytes log_level log_format

	config_get_bool enabled "$section" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get multicast_input "$section" multicast_input
	config_get http_listen "$section" http_listen
	[ -n "$multicast_input" ] && [ -n "$http_listen" ] || {
		logger -t mcastferry "multicast_input and http_listen are required"
		return 1
	}

	network_flush_cache
	network_get_device input_device "$multicast_input" || {
		logger -t mcastferry "unable to resolve logical network $multicast_input"
		return 1
	}

	config_get max_sessions "$section" max_sessions 5
	config_get max_clients "$section" max_clients 5
	config_get max_clients_per_session "$section" max_clients_per_session 5
	config_get max_clients_per_ip "$section" max_clients_per_ip 5
	config_get max_queue_bytes "$section" max_queue_bytes 524288
	config_get client_write_timeout "$section" client_write_timeout 2s
	config_get session_idle_grace "$section" session_idle_grace 1s
	config_get playlist_path "$section" playlist_path
	config_get playlist_route "$section" playlist_route /playlist.m3u
	config_get playlist_max_bytes "$section" playlist_max_bytes 2097152
	config_get log_level "$section" log_level info
	config_get log_format "$section" log_format text

	procd_open_instance "$section"
	procd_set_param command "$PROG"
	procd_append_param command -multicast-input "$input_device"
	procd_append_param command -http-listen "$http_listen"
	config_list_foreach "$section" allowed_group append_list_flag -allowed-group
	config_list_foreach "$section" allowed_client append_list_flag -allowed-client
	config_list_foreach "$section" allowed_port append_list_flag -allowed-port
	procd_append_param command -max-sessions "$max_sessions"
	procd_append_param command -max-clients "$max_clients"
	procd_append_param command -max-clients-per-session "$max_clients_per_session"
	procd_append_param command -max-clients-per-ip "$max_clients_per_ip"
	procd_append_param command -max-queue-bytes "$max_queue_bytes"
	procd_append_param command -client-write-timeout "$client_write_timeout"
	procd_append_param command -session-idle-grace "$session_idle_grace"
	procd_append_param command -log-level "$log_level"
	procd_append_param command -log-format "$log_format"
	if [ -n "$playlist_path" ]; then
		procd_append_param command -playlist-path "$playlist_path"
		procd_append_param command -playlist-route "$playlist_route"
		procd_append_param command -playlist-max-bytes "$playlist_max_bytes"
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

add_network_trigger() {
	local section="$1"
	local multicast_input
	config_get multicast_input "$section" multicast_input
	[ -n "$multicast_input" ] && \
		procd_add_interface_trigger "interface.*" "$multicast_input" /etc/init.d/mcastferry restart
}

start_service() {
	. /lib/functions/network.sh
	config_load mcastferry
	config_foreach start_instance mcastferry
}

service_triggers() {
	. /lib/functions/network.sh
	procd_add_reload_trigger mcastferry
	config_load mcastferry
	config_foreach add_network_trigger mcastferry
}
